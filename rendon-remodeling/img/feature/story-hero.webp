<style id="wp-custom-css">
.serviceshome{
	box-shadow: -1px 4px 40px 0px rgba(0, 0, 0, 0.15) !important;
}

.quality01{
	height:190px;
}


.wil-timeline__time span {
	color: var(--primary-600, #523100);
/* Body/Highlights */
font-family: Poppins;
font-size: 20px;
font-style: normal;
font-weight: 500;
line-height: normal;
}

h2.wil-timeline__title{
	color: var(--primary-600, #523100);
}

.wil-timeline__content {
    background: #ECEAEA;
    padding: 20px;
    border-radius: 10px;
}

/**/
.iconsprocess {
    width: 40px;
    position: absolute;
    margin-left: -68px;
    margin-top: -17px;
    z-index: 1;
}

.iconsprocess02 {
    width: 40px;
    position: absolute;
    right: 47.5%;
    margin-top: -15px;
}

.wil-timeline-wrapper .w\:16px {
    width: 0px !important;
}
.wil-timeline-wrapper .h\:16px {
    height: 0px !important;
}
/**/

/*MODULE TIMELINE*/
.pos\:absolute.z\:9.t\:50\%.r\:-44px\@\+md.l\:50\%\@md.trf\:translate\(-50\%\,-50\%\)_rotate\(45deg\).w\:16px.h\:16px.bgc\:\#fff.c\:\#eee.bd\:2px_solid_currentcolor {
    z-index: 0;
}

.wil-timeline-wrapper .bgc\:\#eee {
    background-color: #F7AD71 !important;
	z-index:1 !important;
}


/*FIN MODULE TIMELINE*/
@media only screen and (max-width: 1024px) {
  .elementor-sticky--active {
    background: #fff !important;
}
}

@media only screen and (max-width: 768px){
	.quality01{
	height:250px;
}
}

@media only screen and (max-width: 600px){
	.quality01{
	height:180px;
}
	.iconsprocess {
    display:none !important;
}

.iconsprocess02 {
       display:none !important;
	}
}

.eael-gallery-grid-item {
  width: 260px; 
  height: 300px;
}

.gallery-item-thumbnail-wrap {
  width: 100%;
  height: 100%;
  background-color: black; /* fallback color */
  background-position: center;
  background-size: cover;
}
